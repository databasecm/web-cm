APP_NAME="CV Cimandiri"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Real MySQL (Dusk runs a real server + browser; no sqlite, no transactions).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=web_cm
DB_USERNAME=root
DB_PASSWORD=

# Owner seed values (only used if the Owner is seeded; harmless for Dusk).
OWNER_NAME="Owner Dusk"
OWNER_EMAIL=owner.dusk@contoh.test
OWNER_PASSWORD=password

# File session so the login cookie persists between the served app and browser.
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Run jobs inline (settlement/notifications) during a browser interaction.
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local
MEDIA_DISK=media

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_MAILER=log

# Payment stays on the credential-free simulated gateway for browser tests.
PAYMENT_GATEWAY=simulated
